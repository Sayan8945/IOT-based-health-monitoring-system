# MongoDB Atlas Connection (leave empty to run in-memory without persistence)
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=smarthealth_iot
MONGODB_TTL_DAYS=30
MONGODB_TIMEOUT_MS=5000

# Optional shared token for ESP32 HTTP ingestion (leave empty to allow open local dev)
DEVICE_AUTH_TOKEN=

# Optional WebSocket query token (leave empty for open dashboard dev)
WS_AUTH_TOKEN=

# ESP32 ADC scaling for raw integer ecg_samples (12-bit = 4095, 10-bit = 1023)
ECG_ADC_MAX=4095
ECG_MV_RANGE=3.3

# In-memory telemetry history buffer size
TELEMETRY_HISTORY_MAXLEN=100
